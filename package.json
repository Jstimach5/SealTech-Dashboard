{
  "name": "sealtech-board",
  "private": true,
  "version": "0.1.0",
  "description": "SealTech office production board: a derived, read-mostly wall board fed from Jobber and two existing Google Sheets.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "fixtures"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "build": "npm run build -w packages/domain && npm run build -w apps/board && npm run build -w apps/service",
    "fixtures": "npm run build:snapshot -w @sealtech/fixtures",
    "demo": "npm run demo -w apps/board",
    "dev": "npm run dev -w apps/board",
    "service": "npm run dev -w apps/service",
    "lint": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.10.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
