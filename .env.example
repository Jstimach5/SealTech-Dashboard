# SealTech board service configuration.
# The real file lives ONLY at C:\SealTech\board\.env on the office PC. Never commit it.

# fixtures | live
BOARD_DATA_SOURCE=fixtures
# Scenario overlay for fixtures: huddle-day | late-afternoon | stale | overflow | monday-scorecard
FIXTURE_SCENARIO=huddle-day
# Freeze the clock for deterministic fixtures/screenshots (ISO 8601, Z or an offset). Blank = real time.
# Stored as the same instant in UTC Z form (an offset like -04:00 is converted on start).
FIXTURE_NOW=

# Jobber developer app (created by the owner's Cowork session; see docs/jobber-app-handoff.md)
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
# Pin the GraphQL version the explorer shows when the app is created.
JOBBER_GRAPHQL_VERSION=
# off | on  — Jobber note writes stay queued until this is on.
JOBBER_WRITES=off

# Google service account (JSON key path). The account is shared on both sheets.
GOOGLE_SA_KEY_PATH=
REVIEW_SHEET_ID=1wXopOPZuS5ro_hvvai6Ge3m7hfnzSdrOCOxADEDTgTs
KPI_SHEET_ID=1ZeFPvKbKEeL-jxCs8cbE5gJdTvm5smmR2u0z3oAnIAU

# Roster of people (name, initials, Jobber user id, role, PIN hash). Edited only by the owner.
# Live mode refuses to start while this is the fixture roster (any -test- user id): replace it first.
ROSTER_PATH=./data/roster.json
# Email-to-SMS address for the single no-ACK alert. Never written to the log.
ALERT_TO=

# Provisional until the CLEAResult submission window is confirmed in the current manual.
HARD_RED_DAYS=20
# false during the 4-week baseline; true afterwards.
SHOW_TARGETS=false

TZ=America/Detroit
PORT=8787
# Address the service listens on. The board PC (kiosk browser on this machine) is the only client,
# so the default is loopback. Set 0.0.0.0 (or one LAN address) only if another device must reach it:
# the API has PIN sign-in over plain HTTP and is then reachable by everyone on that network.
HOST=127.0.0.1
# Where board.db, snapshot.json and roster.json live (default ./data under apps/service).
DATA_DIR=./data
# The built board the service serves (default ../board/dist).
BOARD_DIST=../board/dist
# Shown in the footer; defaults to the git short hash.
BOARD_BUILD=
